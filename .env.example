PORT=8787
YTDLP_PATH=
# Fallback client chain to dodge YouTube bot-check without cookies; pairs with
# the bgutil PO token provider (see deploy/). Revisit periodically — yt-dlp's
# viable client list shifts as YouTube breaks/unbreaks them.
YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=tv,web_safari
YTDLP_COOKIES_FILE=
