[Unit]
Description=bgutil yt-dlp PO token provider
After=network.target

[Service]
WorkingDirectory=/home/ubuntu/bgutil-ytdlp-pot-provider/server
# Adjust if `node` isn't at this path (check `which node` as the ubuntu user).
ExecStart=/usr/bin/node build/main.js
Restart=on-failure
RestartSec=5
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
